<Window x:Class="Typemetric.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Typemetric.UI.Controls"
        Title="AG Nova Typemetric" 
        SizeToContent="WidthAndHeight" MinWidth="1050" MinHeight="650"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <!-- Main Chassis Frame -->
    <Border Background="{StaticResource NovaSpace}" BorderBrush="{StaticResource NovaBorder}" BorderThickness="2">


        <Grid>
            <!-- Background Grid Lines -->
            <Border Background="{StaticResource NovaGridBackground}" Opacity="0.5" />
            
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="N.O.V.A. OS" Foreground="{StaticResource NovaTextPrimary}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text=" // TYPEMETRIC KINEMATICS" Foreground="{StaticResource NovaCyan}" FontSize="16" Margin="8,0,0,0" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="RadioToday" Content="TODAY" IsChecked="True" Foreground="{StaticResource NovaTextPrimary}" Margin="0,0,16,0" Checked="Timeframe_Changed" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RadioAllTime" Content="ALL-TIME" Foreground="{StaticResource NovaTextPrimary}" Checked="Timeframe_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                
                <!-- STATUS INFO -->
                <Border Grid.Row="1" Background="{StaticResource NovaPanelAlt}" BorderBrush="{StaticResource NovaBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="STATUS: LIVE" Foreground="{StaticResource NovaCyanBright}" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="Telemetry is currently aggregating. Sequence logging is strictly DISABLED." Foreground="{StaticResource NovaTextSecondary}" FontSize="14" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- LIVE METRICS -->
                <Border Grid.Row="2" Background="{StaticResource NovaPanel}" BorderBrush="{StaticResource NovaBorder}" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="KEYSTROKES (TODAY)" Foreground="{StaticResource NovaTextMuted}" FontFamily="Consolas" FontSize="12"/>
                            <TextBlock x:Name="KeysTextBlock" Text="0" Foreground="{StaticResource NovaIvory}" FontSize="36" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="MOUSE CLICKS (TODAY)" Foreground="{StaticResource NovaTextMuted}" FontFamily="Consolas" FontSize="12"/>
                            <TextBlock x:Name="MouseTextBlock" Text="0" Foreground="{StaticResource NovaIvory}" FontSize="36" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="SCROLL TICKS (TODAY)" Foreground="{StaticResource NovaTextMuted}" FontFamily="Consolas" FontSize="12"/>
                            <TextBlock x:Name="ScrollTextBlock" Text="0" Foreground="{StaticResource NovaIvory}" FontSize="36" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- VISUAL HEATMAP -->
                <Border Grid.Row="3" Background="{StaticResource NovaSpace}" BorderBrush="{StaticResource NovaBorder}" BorderThickness="1" Padding="24" Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <controls:VisualKeyboard x:Name="HeatmapKeyboard" />
                        <controls:VisualMouse x:Name="HeatmapMouse" Margin="24,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- FOOTER / CONTROLS -->
                <Grid Grid.Row="4" Margin="0,24,0,0">
                    <TextBlock Text="STARDATE: 2026.09" Foreground="{StaticResource NovaTextDiagnostic}" FontFamily="Consolas" VerticalAlignment="Center" />
                    
                    <Button Content="HIDE TERMINAL" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Background="{StaticResource NovaPanelAlt}" Foreground="{StaticResource NovaTextPrimary}" 
                            BorderBrush="{StaticResource NovaBorder}" BorderThickness="1" Padding="16,8" 
                            Click="CloseButton_Click" Cursor="Hand" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
