<UserControl x:Class="Typemetric.UI.Controls.VisualMouse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="100" Height="160" Background="Transparent">
        <!-- Body of Mouse -->
        <Border BorderBrush="{StaticResource NovaBorder}" BorderThickness="2" CornerRadius="50,50,30,30" Background="{StaticResource NovaSpace}" />
        
        <!-- Left Button -->
        <Border x:Name="BtnLeft" Width="44" Height="60" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="46,0,0,0" BorderBrush="{StaticResource NovaBorder}" BorderThickness="2,2,1,2" Background="{StaticResource NovaPanel}" Margin="2,2,0,0" />
        
        <!-- Right Button -->
        <Border x:Name="BtnRight" Width="44" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="0,46,0,0" BorderBrush="{StaticResource NovaBorder}" BorderThickness="1,2,2,2" Background="{StaticResource NovaPanel}" Margin="0,2,2,0" />
        
        <!-- Scroll Wheel -->
        <Border x:Name="BtnMiddle" Width="8" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="4" BorderBrush="{StaticResource NovaBorder}" BorderThickness="1" Background="{StaticResource NovaPanel}" Margin="0,18,0,0" />
        
        <TextBlock Text="MOUSE" Foreground="{StaticResource NovaTextMuted}" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
    </Grid>
</UserControl>
