<Window x:Class="Typemetric.UI.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typemetric Setup" Height="300" Width="550"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    
    <Border Background="{StaticResource NovaSpace}" BorderBrush="{StaticResource NovaBorder}" BorderThickness="2">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="TYPEMETRIC // INITIALIZATION" Foreground="{StaticResource NovaCyan}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock Grid.Row="1" Text="Select a secure location to store your telemetry database (metrics.db). This can be a synced folder like OneDrive or Dropbox to ensure data recovery." Foreground="{StaticResource NovaTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,24" FontSize="14"/>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox x:Name="PathTextBox" Width="360" Height="36" Background="{StaticResource NovaPanelAlt}" Foreground="{StaticResource NovaTextPrimary}" BorderBrush="{StaticResource NovaBorder}" Padding="8" IsReadOnly="True" VerticalContentAlignment="Center"/>
                <Button Content="BROWSE" Margin="12,0,0,0" Width="100" Height="36" Background="{StaticResource NovaPanelAlt}" Foreground="{StaticResource NovaTextPrimary}" BorderBrush="{StaticResource NovaBorder}" Click="BrowseButton_Click" Cursor="Hand"/>
            </StackPanel>

            <Button Grid.Row="3" Content="INITIALIZE CORE" HorizontalAlignment="Right" Background="{StaticResource NovaCyan}" Foreground="{StaticResource NovaSpace}" FontWeight="Bold" Padding="24,12" Click="InitButton_Click" Cursor="Hand" BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
